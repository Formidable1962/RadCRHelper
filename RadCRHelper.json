// Rad CR Helper settings. Comments like this one are allowed.
// This file sits next to RadCRHelper.exe. Edit it, then restart the app (or sign out and back in).
{
  // Bump only when the SHAPE of this file changes. The app warns if this is newer than it understands.
  "configVersion": 1,

  "panel": {
    "widthDip": 320,          // expanded panel width
    "tabWidthDip": 22,        // collapsed tab on the right edge
    "tabHeightDip": 110,
    "startExpanded": true,    // open or collapsed when the app starts at sign-in
    "hideFromScreenShare": true, // hide the panel from Zoom/Teams screen sharing (NOT from the mirrored TV)
    "theme": "Dark",          // Dark or Light
    "accentColor": "#FFCD00"  // Iowa gold
  },

  "display": {
    "defaultModeAtLogin": "Mirror", // Mirror, Extend, or None (leave as-is)
    "revertSeconds": 15              // "Keep this screen setting?" countdown
  },

  "session": {
    "countdownSeconds": 30           // Sign out / Restart countdown
  },

  // Keyboard shortcuts. Any action name from README.md works here.
  // A future USB macro deck can send F13-F24, which no normal program uses.
  "hotkeys": [
    { "keys": "Ctrl+Alt+H", "action": "panel.toggle" },
    { "keys": "Ctrl+Alt+Shift+X", "action": "app.exit" }   // admin only: closes the app
  ],

  // Quick links: buttons, top to bottom in this order.
  //   group    - heading the button sits under; groups show in the order they first appear
  //   id       - optional; action name becomes "link.<id>" for hotkeys / macro deck
  //   icon     - optional Fluent icon name (Video24, Globe24, People24, Link24 ...). Default Video24.
  //   url      - http, https, zoommtg, zoomus or msteams
  //   openWith - default (Windows decides), edge (Edge, then Chrome), edgeApp (same, as an app window)
  //   fallbackApp   - "outlook": if no Edge or Chrome, open installed Outlook; if that fails, tell the user
  //   outlookFolder - "calendar" or "inbox" for that fallback
  //   localApp - installed program to open first (e.g. POWERPNT.EXE); if missing, the user is asked
  //              whether to open "url" instead
  "links": [
    {
      "group": "Zoom meetings",
      "id": "resident-conference",
      "label": "Resident Conference",
      "subtitle": "Join the Zoom meeting",
      "url": "http://medicine.uiowa.edu/Radiology/residentconference",
      "icon": "Video24",
      "openWith": "edge"
    },
    {
      "group": "Office 365",
      "id": "powerpoint",
      "label": "PowerPoint",
      "subtitle": "Open PowerPoint on this computer",
      "localApp": "POWERPNT.EXE",
      "url": "https://www.microsoft365.com/launch/powerpoint",
      "icon": "SlideMultiple24",
      "openWith": "edgeApp"
    },
    {
      "group": "Office 365",
      "id": "onedrive",
      "label": "Your OneDrive",
      "subtitle": "Your files",
      "url": "https://iowa-my.sharepoint.com/my",
      "icon": "Cloud24",
      "openWith": "edgeApp"
    },
    {
      "group": "Office 365",
      "id": "todays-calendar",
      "label": "Your Calendar",
      "subtitle": "Today in your Outlook calendar",
      "url": "https://outlook.cloud.microsoft/calendar/view/day",
      "icon": "CalendarToday24",
      "openWith": "edgeApp",
      "fallbackApp": "outlook",
      "outlookFolder": "calendar"
    },
    {
      "group": "Office 365",
      "id": "email",
      "label": "Your Mail",
      "subtitle": "Your Outlook inbox",
      "url": "https://outlook.cloud.microsoft/mail/",
      "icon": "Mail24",
      "openWith": "edgeApp",
      "fallbackApp": "outlook",
      "outlookFolder": "inbox"
    }
  ],

  // Groups shown as side-by-side tiles (icon + short label; subtitle becomes the tooltip).
  // Unlisted groups get one full-width button per row.
  "groupColumns": {
    "Office 365": 2
  },

  // Per-room settings, keyed by computer name (shown in Room Info).
  "rooms": {
    "EXAMPLE-PC-NAME": {
      "roomName": "Example Conference Room",
      "presenterDisplay": "DELL P2422H", // the desk monitor; stays the main screen in Extend. Name as shown in Room Info.
      "hideDisplayControls": false,       // true for rooms that will never have a second screen
      "defaultModeAtLogin": "Mirror"      // optional: overrides display.defaultModeAtLogin for this PC
    },
    "DESKTOP-QQBPGRM": {
      "roomName": "Allen's desk (development)",
      "defaultModeAtLogin": "None"        // don't mirror the home monitors while testing
    }
  }
}
